\title{A Machine-Learning-Based Spatial Autocorrelation Statistic}
\description{Implementation of learned attribute similarity and spatial randomization inference.}
\details{Start with \code{\link{mlsas_example}} and \code{\link{mlsas}}.
Default settings follow the empirical analysis in the accompanying paper.
The tutorial provides complete small-data workflows.}
\author{Woohyung Kim and Sang-Il Lee. Maintainer: Woohyung Kim \email{whk3423@snu.ac.kr}.}
\references{Kim, W. and Lee, S.-I. (2026). ML-SAS: A Machine-Learning-Based Spatial Autocorrelation Statistic for Mixed-Type Data. \emph{Geographical Analysis}, 58(4), e70062. \doi{10.1111/gean.70062}.}
